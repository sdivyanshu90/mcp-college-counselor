DATABASE_URL=sqlite+aio:///./data/university.db
MODEL_PROVIDER=openrouter            # anthropic | openai | openrouter
ANTHROPIC_API_KEY=                   # Required only if MODEL_PROVIDER=anthropic
OPENAI_API_KEY=                      # Required only if MODEL_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=                  # Required only if MODEL_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_EXTRACTION_MODEL=openai/gpt-oss-20b:free
CLIENT_MODEL=openai/gpt-oss-20b:free
SCRAPE_DELAY_MIN=3                    # Seconds, float
SCRAPE_DELAY_MAX=9
EXTRACTION_CACHE_TTL=86400            # Seconds
LOG_LEVEL=INFO